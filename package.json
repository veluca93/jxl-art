{
  "name": "jxl-art",
  "version": "2.0.0",
  "type": "module",
  "description": "Create art using JPEG XL prediction trees",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ghpages": "tsc && BASE_PATH=/jxl-art/ vite build",
    "preview": "vite preview",
    "build:wasm": "./scripts/build-libjxl.sh",
    "validate:presets": "node scripts/validate-presets.js"
  },
  "keywords": [
    "jpeg-xl",
    "jxl",
    "art",
    "wasm",
    "image"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0"
  },
  "dependencies": {
    "comlink": "^4.4.1",
    "idb-keyval": "^6.2.1",
    "pako": "^2.1.0"
  }
}
